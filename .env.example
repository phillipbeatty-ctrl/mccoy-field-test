SUPABASE_SERVICE_ROLE_KEY=
MCCOY_DEV_INTERNAL_TOKEN=
MCCOY_ADMIN_MOBILE=+1XXXXXXXXXX
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_WEBHOOK_URL=https://mccoy-field-test.vercel.app/api/sms-command

# Server-only Supabase Edge Function secret. Restrict this key to the Geocoding
# API and never put it in index.html or browser JavaScript.
GOOGLE_MAPS_API_KEY=

# Preview-only PUBLIC configuration. The web build refuses missing values,
# production project refs/keys, and secret/service-role keys. Use values from
# an approved isolated Supabase branch, with no customer data.
MCCOY_PREVIEW_SUPABASE_URL=
MCCOY_PREVIEW_SUPABASE_PUBLISHABLE_KEY=
# VERCEL_ENV and VERCEL_URL are provided by Vercel; do not override them.
